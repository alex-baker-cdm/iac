# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control

# GitHub Configuration
# Used for GitHub Enterprise API access and statistics
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_API_URL=https://github.example.com/api/v3

# Microsoft Dynamics
# Used for querying Microsoft Dynamics data
ACCESS_TOKEN=your_microsoft_access_token_here

# AWS Configuration
# AWS credentials (alternative to AWS CLI configuration)
# If using AWS CLI config files, these are optional
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=default

# Azure Configuration
# Azure subscription and resource details
AZURE_SUBSCRIPTION_ID=your_subscription_id_here
AZURE_RESOURCE_GROUP=your_resource_group_name
AZURE_LOCATION=eastus
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret
AZURE_TENANT_ID=your_tenant_id

# Terraform Configuration
# Terraform-specific variables
TF_VAR_environment=development
TF_VAR_project_name=iac-examples

# Node.js Configuration
NODE_ENV=development

# Deployment Configuration
# Settings for deployment operations
DEPLOY_TIMEOUT=300
RETRY_ATTEMPTS=3

# Logging Configuration
LOG_LEVEL=info
DEBUG=false
